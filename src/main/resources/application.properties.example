# App
spring.application.name=worksphere

# Database
spring.datasource.url=jdbc:mysql://localhost:3306/worksphere
spring.datasource.username=your_username
spring.datasource.password=your_password

# JPA
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Server
server.port=8080

# JWT
# Tip: Generate your secret
# In Linux bash: openssl rand -base64 64
# In Windows GitBash: openssl rand -base64 64
jwt.secret=your_base64_secret_here
jwt.expiration=86400000
jwt.refresh-expiration=604800000